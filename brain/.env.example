# Where the SQLite database lives (relative to this folder).
DATABASE_URL="file:./data/brain.db"

# --- Optional: password protection -------------------------------------
# Leave both empty when the app only listens on 127.0.0.1 (the default).
# Set them before exposing the app to other devices on your network.
#   npm run hash-password      → prints a value for AUTH_PASSWORD_HASH
#   openssl rand -hex 32        → a value for AUTH_SECRET
AUTH_PASSWORD_HASH=""
AUTH_SECRET=""
