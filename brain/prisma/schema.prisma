// Brain — data model.
//
// Everything a person saves is an Item. The Item row carries what every kind
// of thing shares (title, folder, tags, pinning, relations, the search index)
// and a one-to-one detail row carries what only that kind needs. Searching,
// tagging, linking and exporting therefore work on one table, while each type
// keeps its own columns.
//
// Portability rules, so PostgreSQL can replace SQLite by changing `provider`
// and regenerating migrations:
//   * only String / Int / Boolean / DateTime columns — no Json, no enums
//     (allowed values are enforced by zod in src/lib/validation.ts);
//   * UUID primary keys generated by the application;
//   * `searchText` is stored lower-cased so `contains` is case-insensitive on
//     every database without provider-specific collation.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(uuid())
  name      String   @default("Me")
  // Reserved for multi-user sync. A local install has exactly one user and
  // authentication (if enabled) is configured with environment variables.
  email     String?  @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items   Item[]
  folders Folder[]
  tags    Tag[]

  @@map("users")
}

model Folder {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  parentId  String?  @map("parent_id")
  name      String
  position  Int      @default(0)
  pinned    Boolean  @default(false)
  favorite  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Folder[] @relation("FolderTree")
  items    Item[]

  @@index([userId, parentId, position])
  @@map("folders")
}

model Item {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  // TASK | NOTE | BOOKMARK | LINK
  type       String
  title      String
  folderId   String?   @map("folder_id")
  pinned     Boolean   @default(false)
  favorite   Boolean   @default(false)
  // Captured but not yet organised.
  inbox      Boolean   @default(false)
  // Lower-cased title, body, URL, tags and folder path. Rebuilt whenever any
  // of those change (src/server/search-index.ts).
  searchText String    @default("") @map("search_text")
  createdAt  DateTime  @default(now()) @map("created_at")
  // Set by the app when the user changes the item, not by Prisma: rebuilding
  // the search index after a folder rename must not count as "edited".
  updatedAt  DateTime  @default(now()) @map("updated_at")
  archivedAt DateTime? @map("archived_at")

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder    Folder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  task      Task?         @relation("ItemTask")
  note      Note?
  bookmark  Bookmark?
  tags      ItemTag[]
  reminders Reminder[]
  outgoing  ItemRelation[] @relation("RelationSource")
  incoming  ItemRelation[] @relation("RelationTarget")
  subtasks  Task[]        @relation("Subtasks")

  @@index([userId, type, archivedAt])
  @@index([userId, inbox])
  @@index([folderId])
  @@index([updatedAt])
  @@map("items")
}

model Task {
  itemId          String    @id @map("item_id")
  description     String    @default("")
  // INBOX | TODO | IN_PROGRESS | WAITING | DONE
  status          String    @default("TODO")
  // LOW | NORMAL | HIGH | URGENT
  priority        String    @default("NORMAL")
  // Local calendar date (YYYY-MM-DD) and time (HH:MM). Stored as text on
  // purpose: a due date is a day on the user's calendar, not an instant, and
  // must not shift when the server's time zone differs from the browser's.
  dueDate         String?   @map("due_date")
  dueTime         String?   @map("due_time")
  url             String?
  // NONE | DAILY | WEEKDAYS | WEEKLY | MONTHLY | YEARLY
  recurrence      String    @default("NONE")
  parentId        String?   @map("parent_id")
  position        Int       @default(0)
  completedAt     DateTime? @map("completed_at")
  lastCompletedAt DateTime? @map("last_completed_at")

  item   Item  @relation("ItemTask", fields: [itemId], references: [id], onDelete: Cascade)
  parent Item? @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)

  @@index([dueDate])
  @@index([status])
  @@index([parentId])
  @@map("tasks")
}

model Note {
  itemId      String @id @map("item_id")
  // TipTap/ProseMirror document as JSON text.
  content     String @default("")
  // Plain-text rendering of `content`, for search and previews.
  contentText String @default("") @map("content_text")

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("notes")
}

// Used by both BOOKMARK and LINK items: they have the same shape and differ
// in purpose (things to read vs. places you go to).
model Bookmark {
  itemId        String  @id @map("item_id")
  url           String
  domain        String  @default("")
  faviconUrl    String? @map("favicon_url")
  siteTitle     String? @map("site_title")
  description   String  @default("")
  notes         String  @default("")
  // A link to the entry in an external password manager — never the
  // credential itself.
  credentialUrl String? @map("credential_url")

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([domain])
  @@map("bookmarks")
}

model Tag {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ItemTag[]

  @@unique([userId, name])
  @@map("tags")
}

model ItemTag {
  itemId    String   @map("item_id")
  tagId     String   @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
  @@index([tagId])
  @@map("item_tags")
}

model ItemRelation {
  id        String   @id @default(uuid())
  sourceId  String   @map("source_id")
  targetId  String   @map("target_id")
  // MANUAL (linked from Related Items) | WIKILINK (a [[link]] in the text,
  // kept in sync with the text on every save).
  origin    String   @default("MANUAL")
  createdAt DateTime @default(now()) @map("created_at")

  source Item @relation("RelationSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target Item @relation("RelationTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, origin])
  @@index([targetId])
  @@map("item_relations")
}

model Reminder {
  id        String    @id @default(uuid())
  itemId    String    @map("item_id")
  remindAt  DateTime  @map("remind_at")
  firedAt   DateTime? @map("fired_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([remindAt, firedAt])
  @@map("reminders")
}
